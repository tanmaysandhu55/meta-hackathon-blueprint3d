# FloorPlan3D - Partner Cloud Configuration
# We use partner cloud endpoints for Meta's models:

# 1. Baseten custom-model endpoint: SAM 3.1 (Image Segmentation)
BASETEN_API_KEY=
# Optional full endpoint URL. If blank, BASETEN_MODEL_ID builds the standard /production/predict URL.
BASETEN_SAM_URL=
BASETEN_MODEL_ID=

# 2. Fireworks Endpoint: Meta Llama 3 (Text/NLP Generation & Reasoning)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_LLAMA_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# 3. Modal serverless endpoint running Muse Spark (Room / Region Labeling)
# Modal proxy token, combined as wk-<token-id>.ws-<token-secret>
MODAL_API_KEY=
# Endpoint URL and model name from the Modal Endpoint dashboard
MODAL_MUSE_SPARK_URL=
MODAL_MUSE_SPARK_MODEL=

# Spatial calibration defaults (in meters)
DEFAULT_METERS_PER_PIXEL=0.02
DEFAULT_WALL_HEIGHT=3.0
DEFAULT_WALL_THICKNESS=0.2

# Flask server configuration
PORT=5000
FLASK_DEBUG=0
