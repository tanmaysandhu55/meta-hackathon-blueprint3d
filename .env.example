# Meta Model API Configuration
MODEL_API_KEY=your_meta_model_api_key_here
MODEL_BASE_URL=https://api.meta.ai/v1
SAM_MODEL=sam-3.1
MUSE_MODEL=muse-spark-1.3

# Runtime Mode (1 = Mock Mode for safe local development/demo; 0 = Live Meta Model API)
MOCK_AI=1

# Guards and Timeouts
MAX_SAM_CALLS_PER_UPLOAD=12
SAM_TIMEOUT=75
MUSE_TIMEOUT=30
