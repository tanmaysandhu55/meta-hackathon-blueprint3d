# FloorPlan3D Environment Configuration
# Copy this file to .env and insert your Meta Model API Key.

# Meta Model API Key from https://dev.meta.ai/
MODEL_API_KEY=your_meta_api_key_here

# Meta Model API Base URL (OpenAI-SDK compatible endpoint)
MODEL_BASE_URL=https://api.meta.ai/v1

# Segment Anything Model 3.1 identifier
SAM_MODEL=sam-3.1

# Meta Muse Spark Model identifier (Standard-tier only, never "-contributor")
MUSE_MODEL=muse-spark-1.3

# Spatial calibration defaults (in meters)
DEFAULT_METERS_PER_PIXEL=0.02
DEFAULT_WALL_HEIGHT=3.0
DEFAULT_WALL_THICKNESS=0.2

# Flask server port
PORT=5000
FLASK_DEBUG=1
