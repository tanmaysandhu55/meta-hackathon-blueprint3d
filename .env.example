# FloorPlan3D - Partner Cloud Configuration
# We use partner cloud endpoints for Meta's models:

# 1. Baseten Endpoint: Meta SAM 3.1 (Image Segmentation)
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_SAM_URL=https://model-<MODEL_ID>.api.baseten.co/environments/production/sync/v1
BASETEN_MODEL_ID=

# 2. Fireworks Endpoint: Meta Llama 3 (Text/NLP Generation & Reasoning)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_LLAMA_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# 3. Modal Serverless Endpoint: Meta Muse Spark (Region Labeling)
MODAL_API_KEY=your_modal_api_key_here
MODAL_MUSE_SPARK_URL=https://<your-workspace>--muse-spark-classify.modal.run

# Spatial calibration defaults (in meters)
DEFAULT_METERS_PER_PIXEL=0.02
DEFAULT_WALL_HEIGHT=3.0
DEFAULT_WALL_THICKNESS=0.2

# Flask server configuration
PORT=5000
FLASK_DEBUG=1
