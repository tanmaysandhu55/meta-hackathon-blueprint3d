# ==============================================================================
# FloorPlan3D — Environment Configuration & API Keys
# ==============================================================================

# --- 1. Baseten API Configuration (Room Labeling & Chat Assistant) ---
# Model: meta-models/muse-spark-open-1026
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MUSE_MODEL=meta-models/muse-spark-open-1026

# --- 2. Meta Model API Configuration (SAM 3.1, Muse Image, Muse Voice) ---
# Accepts META_API_KEY or MODEL_API_KEY
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
SAM_MODEL=sam-3.1
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0

# --- 3. Operational Mode & Architectural Defaults ---
# MOCK_AI: Set to 1 to run pipeline in test mock mode without using API credits
MOCK_AI=0

# Architectural Scale & Dimensions (in meters)
DEFAULT_METERS_PER_PIXEL=0.02
DEFAULT_WALL_HEIGHT=3.0
DEFAULT_WALL_THICKNESS=0.2

# Server Port and Debug settings
PORT=5000
FLASK_DEBUG=0
